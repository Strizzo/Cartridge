# Cross-compilation image for the handheld (aarch64-unknown-linux-gnu).
#
# Use the base image cross itself selects -- it passes CROSS_BASE_IMAGE for the
# cross version in use -- rather than `:main`. `:main` follows the newest
# Ubuntu, which moved apt to the deb822 `ubuntu.sources` format; the arm64
# entries added below then collide with it and the multiarch install fails.
ARG CROSS_BASE_IMAGE
FROM ${CROSS_BASE_IMAGE:-ghcr.io/cross-rs/aarch64-unknown-linux-gnu:0.2.5}

# Restrict the stock repositories to the host architecture before enabling
# arm64, so apt never looks for arm64 packages on archive.ubuntu.com (which
# does not carry them). Handles the classic and deb822 layouts alike.
RUN dpkg --add-architecture arm64 && \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|^deb \(http\)|deb [arch=amd64] \1|' /etc/apt/sources.list; \
    fi && \
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i '/^Types:/a Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources; \
    fi && \
    CODENAME=$(. /etc/os-release && echo $VERSION_CODENAME) && \
    printf 'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports %s main universe\ndeb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports %s-updates main universe\n' \
        "$CODENAME" "$CODENAME" > /etc/apt/sources.list.d/arm64.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libsdl2-dev:arm64 \
        libsdl2-ttf-dev:arm64 \
        libsdl2-image-dev:arm64 \
        libsdl2-gfx-dev:arm64 \
        libasound2-dev:arm64 && \
    rm -rf /var/lib/apt/lists/*

ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig
ENV PKG_CONFIG_ALLOW_CROSS=1
